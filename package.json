{
  "name": "crunchyroll",
  "productName": "Crunchyroll",
  "version": "1.0.1",
  "description": "An unofficial cross-platform Crunchyroll desktop application for Linux, Windows, and macOS with Widevine DRM support",
  "main": "main.js",
  "author": "CodesRahul96 <codesrahul96@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodesRahul96/Crunchyroll-Desktop.git"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder -mwl"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.codesrahul.crunchyroll",
    "productName": "Crunchyroll",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "resources/**/*"
    ],
    "linux": {
      "maintainer": "CodesRahul96 <codesrahul96@gmail.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Video;Entertainment;",
      "icon": "resources/app/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/app/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Crunchyroll",
      "runAfterFinish": true,
      "menuCategory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment",
      "icon": "resources/app/icon.png"
    },
    "dmg": {
      "title": "Crunchyroll Installer",
      "iconSize": 120,
      "contents": [
        {
          "x": 130,
          "y": 170,
          "type": "file"
        },
        {
          "x": 410,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 360
      }
    },
    "publish": {
      "provider": "github",
      "owner": "CodesRahul96",
      "repo": "Crunchyroll-Desktop"
    }
  }
}
